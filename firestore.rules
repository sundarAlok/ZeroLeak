rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    match /publicProfiles/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.data.keys().hasOnly([
                              'uid', 'name', 'username', 'bio', 'photoURL'
                            ])
                            && request.resource.data.uid == userId;
      allow delete: if false;
    }

    match /conversations/{conversationId} {
      allow create: if request.auth != null
                    && request.resource.data.participants is list
                    && request.auth.uid in request.resource.data.participants;
      allow read, delete: if request.auth != null
                           && request.auth.uid in resource.data.participants;
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.participants
                    && request.resource.data.participants == resource.data.participants;

      match /messages/{messageId} {
        function isParticipant() {
          let convo = get(/databases/$(database)/documents/conversations/$(conversationId));
          return convo != null
                 && convo.data.participants is list
                 && request.auth.uid in convo.data.participants;
        }

        allow create: if request.auth != null
                      && request.resource.data.senderId == request.auth.uid
                      && isParticipant();
        allow read: if request.auth != null && isParticipant();
        allow update: if request.auth != null
                      && isParticipant()
                      && (
                        (
                          request.auth.uid == resource.data.senderId
                          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['text', 'editedAt'])
                        )
                        ||
                        (
                          'reactions' in request.resource.data
                          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['reactions'])
                        )
                      );
        allow delete: if request.auth != null
                      && request.auth.uid == resource.data.senderId
                      && isParticipant();
      }
    }

    match /moments/{momentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /groups/{groupId} {
      function groupExists() {
        return get(/databases/$(database)/documents/groups/$(groupId)) != null;
      }

      function isMember() {
        let group = get(/databases/$(database)/documents/groups/$(groupId));
        return group != null && request.auth.uid in group.data.members;
      }

      allow read: if request.auth != null && groupExists() && isMember();
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.members is list
                    && request.auth.uid in request.resource.data.members;
      allow update: if request.auth != null
                    && isMember()
                    && !('ownerId' in request.resource.data
                         && request.resource.data.ownerId != resource.data.ownerId)
                    && !('members' in request.resource.data
                         && request.resource.data.members != resource.data.members);
      allow delete: if request.auth != null
                    && groupExists()
                    && request.auth.uid == resource.data.ownerId;

      match /messages/{messageId} {
        allow read: if request.auth != null && groupExists() && isMember();
        allow create: if request.auth != null
                      && request.resource.data.senderId == request.auth.uid
                      && groupExists()
                      && isMember();
        allow delete: if request.auth != null
                      && resource.data.senderId == request.auth.uid
                      && groupExists()
                      && isMember();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
