rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    match /publicProfiles/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.data.keys().hasOnly([
                              'uid', 'name', 'username', 'bio', 'photoURL', 'urls'
                            ])
                            && request.resource.data.uid == userId
                            && request.resource.data.urls is list
                            && request.resource.data.urls.size() <= 3;
      allow delete: if false;
    }

    match /conversations/{conversationId} {
      allow create: if request.auth != null
                    && request.resource.data.participants is list
                    && request.auth.uid in request.resource.data.participants;
      allow get: if request.auth != null
                 && (
                   !exists(/databases/$(database)/documents/conversations/$(conversationId))
                   || request.auth.uid in resource.data.participants
                 );
      allow list, delete: if request.auth != null
                          && request.auth.uid in resource.data.participants;
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.participants
                    && (
                      request.resource.data.participants == resource.data.participants
                      || (
                        resource.data.isGroup == true
                        && request.resource.data.isGroup == true
                        && request.resource.data.groupId == resource.data.groupId
                        && request.auth.uid in get(
                          /databases/$(database)/documents/groups/$(resource.data.groupId)
                        ).data.members
                        && (
                          request.auth.uid in get(
                            /databases/$(database)/documents/groups/$(resource.data.groupId)
                          ).data.admins
                          || request.auth.uid == get(
                            /databases/$(database)/documents/groups/$(resource.data.groupId)
                          ).data.ownerId
                        )
                        && request.resource.data.participants == getAfter(
                          /databases/$(database)/documents/groups/$(resource.data.groupId)
                        ).data.members
                      )
                    );

      match /messages/{messageId} {
        function isParticipant() {
          let convo = get(/databases/$(database)/documents/conversations/$(conversationId));
          return convo != null
                 && convo.data.participants is list
                 && request.auth.uid in convo.data.participants;
        }

        allow create: if request.auth != null
                      && request.resource.data.senderId == request.auth.uid
                      && isParticipant();
        allow read: if request.auth != null && isParticipant();
        allow update: if request.auth != null
                      && isParticipant()
                      && (
                        (
                          request.auth.uid == resource.data.senderId
                          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['text', 'editedAt'])
                        )
                        ||
                        (
                          'reactions' in request.resource.data
                          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['reactions'])
                        )
                      );
        allow delete: if request.auth != null
                      && request.auth.uid == resource.data.senderId
                      && isParticipant();
      }
    }

    match /moments/{momentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /groups/{groupId} {
      function groupExists() {
        return get(/databases/$(database)/documents/groups/$(groupId)) != null;
      }

      function isMember() {
        let group = get(/databases/$(database)/documents/groups/$(groupId));
        return group != null && request.auth.uid in group.data.members;
      }

      function isAdmin() {
        let group = get(/databases/$(database)/documents/groups/$(groupId));
        return group != null
               && (
                 request.auth.uid == group.data.ownerId
                 || request.auth.uid in group.data.admins
               );
      }

      allow read: if request.auth != null && groupExists() && isMember();
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.members is list
                    && request.auth.uid in request.resource.data.members
                    && request.resource.data.admins == [request.auth.uid]
                    && request.resource.data.blockedMembers is list
                    && request.resource.data.blockedMembers.size() == 0
                    && request.resource.data.bio is string
                    && request.resource.data.urls is list
                    && request.resource.data.urls.size() <= 3;
      allow update: if request.auth != null
                    && isAdmin()
                    && request.resource.data.ownerId == resource.data.ownerId
                    && request.resource.data.members is list
                    && request.resource.data.admins is list
                    && request.resource.data.blockedMembers is list
                    && request.resource.data.members.hasAll(request.resource.data.admins)
                    && request.resource.data.members.hasAll([resource.data.ownerId])
                    && !request.resource.data.members.hasAny(request.resource.data.blockedMembers)
                    && request.resource.data.bio is string
                    && request.resource.data.urls is list
                    && request.resource.data.urls.size() <= 3
                    && request.resource.data.keys().hasOnly([
                      'name', 'photoURL', 'ownerId', 'members', 'admins',
                      'blockedMembers', 'bio', 'urls', 'createdAt'
                    ])
                    && (
                      request.auth.uid == resource.data.ownerId
                      || request.resource.data.admins == resource.data.admins
                    );
      allow delete: if request.auth != null
                    && groupExists()
                    && request.auth.uid == resource.data.ownerId;

      match /messages/{messageId} {
        allow read: if request.auth != null && groupExists() && isMember();
        allow create: if request.auth != null
                      && request.resource.data.senderId == request.auth.uid
                      && groupExists()
                      && isMember();
        allow delete: if request.auth != null
                      && resource.data.senderId == request.auth.uid
                      && groupExists()
                      && isMember();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
